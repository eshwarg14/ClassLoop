# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:8080
ADMIN_TOKEN=change-me
SECRET_KEY=generate-with-make-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_MODE=true

# --- Omi ---
OMI_WEBHOOK_SECRET=
OMI_API_KEY=
OMI_APP_ID=

# --- Lyzr ---
LYZR_API_KEY=
LYZR_AGENT_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
AGENT_ID=
LYZR_ORCHESTRATOR_AGENT_ID=
LYZR_DETECTOR_AGENT_ID=
LYZR_CONTENT_AGENT_ID=
LYZR_SCHEDULER_AGENT_ID=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=org_memory
QDRANT_COLLECTION_NAME=org_memory
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false

# --- Embeddings ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/classloop.db

# --- Behaviour ---
SILENCE_TIMEOUT_SECONDS=90
CHUNK_SECONDS=45
EPHEMERAL_TTL_HOURS=24
LOG_LEVEL=INFO
PORT=8080
